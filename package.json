{
  "name": "ventard",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/pos",
    "packages/contracts",
    "packages/ui"
  ],
  "scripts": {
    "dev": "next dev --webpack -p 3001",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "native:contract": "vitest run --config scripts/native/vitest.fixtures.config.ts",
    "native:core:test": "cargo test -p ventard-core --locked",
    "native:fixture:test": "cargo test -p ventard-core --features fixture-storage --locked",
    "native:cipher:test": "cargo test -p ventard-core --features encrypted-storage --locked",
    "native:cipher:lint": "cargo clippy -p ventard-core --features encrypted-storage --all-targets --locked -- -D warnings",
    "native:dev": "npm run dev --workspace=@ventard/pos",
    "native:ui:build": "npm run ui:build --workspace=@ventard/pos",
    "native:build:debug": "npm run build:debug --workspace=@ventard/pos",
    "native:shell:test": "node --test scripts/native/shell-contract.test.mjs scripts/native/shell-ui.test.mjs scripts/native/pos-presentation-contract.test.mjs scripts/native/pos-interaction.test.mjs",
    "native:ui:typecheck": "npm run typecheck --workspace=@ventard/pos",
    "native:qa:build": "npm run build:qa --workspace=@ventard/pos",
    "native:qa:test": "node --test scripts/native/checkout-contract.test.mjs scripts/native/checkout-webview.test.mjs",
    "native:core:lint": "cargo clippy -p ventard-core --features fixture-storage --all-targets --locked -- -D warnings"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@sentry/nextjs": "^10.57.0",
    "@supabase/supabase-js": "^2.104.0",
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.22.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "fuse.js": "^7.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-to-print": "^3.3.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.4.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.60.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "wait-on": "^8.0.1"
  }
}
