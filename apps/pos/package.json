{
  "name": "@ventard/pos",
  "version": "0.1.0",
  "private": true,
  "description": "Shell Tauri 2 de prueba; sin operaciones comerciales habilitadas.",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "ui:dev": "vite",
    "ui:build": "tsc --noEmit && vite build",
    "build:debug": "tauri build --debug --no-bundle",
    "build:qa": "tauri build --debug --no-bundle --features qa-spike -- --locked",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.2",
    "@ventard/ui": "0.1.0",
    "html-to-image": "1.11.13",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.4",
    "@tauri-apps/cli": "2.12.1",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.2.4",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
